{"nodes": [{"id": "desiginexample_bildirishnomalar_code_notifications_page", "label": "Bildirishnomalar Notifications Page (Housekeeping Pro)", "file_type": "code", "source_file": "DesiginExample/bildirishnomalar/code.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "desiginexample_bildirishnomalar_code_notification_card", "label": "Notification Card Component", "file_type": "code", "source_file": "DesiginExample/bildirishnomalar/code.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "desiginexample_bildirishnomalar_code_top_app_bar", "label": "TopAppBar Header", "file_type": "code", "source_file": "DesiginExample/bildirishnomalar/code.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "desiginexample_bildirishnomalar_code_bottom_nav_bar", "label": "BottomNavBar Floating Pill Navigation", "file_type": "code", "source_file": "DesiginExample/bildirishnomalar/code.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "desiginexample_bildirishnomalar_code_material_design_tokens", "label": "Material 3 Design Token System (Tailwind Config)", "file_type": "rationale", "source_file": "DesiginExample/bildirishnomalar/code.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The page defines a full Material Design 3 color role vocabulary (primary, surface-container-*, on-surface-variant, error-container, etc.) plus typography and spacing scales inside tailwind.config so every UI element binds to semantic tokens rather than raw hex values, enabling dark mode via darkMode:'class' and consistent theming across the Housekeeping Pro design examples."}, {"id": "desiginexample_bildirishnomalar_code_notification_severity_coding", "label": "Notification Severity Color Coding", "file_type": "rationale", "source_file": "DesiginExample/bildirishnomalar/code.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Each notification card uses a 4px left border and tinted icon chip whose color role encodes the notification type: error (red) for critical emergencies with action buttons (BORISH/RAD ETISH), primary (blue) for new task assignments, secondary for accepted/resolved items shown at reduced opacity, tertiary (orange) for inventory alerts, and outline-variant (gray, faded) for low-priority system messages \u2014 letting workers triage by glance."}, {"id": "desiginexample_bildirishnomalar_code_swipe_micro_interaction", "label": "Notification Swipe Micro-interaction Script", "file_type": "code", "source_file": "DesiginExample/bildirishnomalar/code.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A small touch-event script translates cards left on swipe (visual only, snapping back on touchend) plus a scale(0.98) active state, giving a native-app dismiss affordance without any real dismissal logic in this static prototype."}, {"id": "desiginexample_bildirishnomalar_code_tailwind_css", "label": "Tailwind CSS (CDN, forms + container-queries plugins)", "file_type": "concept", "source_file": "DesiginExample/bildirishnomalar/code.html", "source_location": null, "source_url": "https://cdn.tailwindcss.com", "captured_at": null, "author": null, "contributor": null}, {"id": "desiginexample_bildirishnomalar_code_material_symbols", "label": "Material Symbols Outlined Icon Font", "file_type": "concept", "source_file": "DesiginExample/bildirishnomalar/code.html", "source_location": null, "source_url": "https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined", "captured_at": null, "author": null, "contributor": null}, {"id": "desiginexample_bildirishnomalar_code_inter_font", "lab