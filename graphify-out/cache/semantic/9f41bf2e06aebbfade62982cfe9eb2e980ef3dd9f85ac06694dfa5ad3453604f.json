{"nodes": [{"id": "desiginexample_hospitality_excellence_system_design", "label": "Hospitality Excellence System Design", "file_type": "document", "source_file": "DesiginExample/hospitality_excellence_system/DESIGN.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "desiginexample_hospitality_excellence_system_design_premium_minimalism", "label": "Premium Minimalism Aesthetic", "file_type": "rationale", "source_file": "DesiginExample/hospitality_excellence_system/DESIGN.md", "source_location": "Brand & Style", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Chosen to reduce cognitive load for housekeeping staff in high-pressure environments; prioritizes legibility and rapid information processing via whitespace and light-on-light layering, mirroring five-star hotel standards. All UI translated to Uzbek for local operational clarity."}, {"id": "desiginexample_hospitality_excellence_system_design_color_palette", "label": "Color Palette (Royal Blue anchor)", "file_type": "concept", "source_file": "DesiginExample/hospitality_excellence_system/DESIGN.md", "source_location": "Colors", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Royal Blue #1D4ED8 signals trust and professional rigor; strictly white background emphasizes a sterile, clean environment appropriate for hotel housekeeping."}, {"id": "desiginexample_hospitality_excellence_system_design_status_colors", "label": "Room Status Colors (Tozalangan/Tayyor/Jarayonda/Muammo/Tozalanishi kerak)", "file_type": "concept", "source_file": "DesiginExample/hospitality_excellence_system/DESIGN.md", "source_location": "Colors", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Status colors are functional signifiers, not decoration: orange for In Progress prevents management double-booking; red flags issues needing immediate attention; neutral gray marks the baseline pending state."}, {"id": "desiginexample_hospitality_excellence_system_design_typography", "label": "Inter Typography System", "file_type": "concept", "source_file": "DesiginExample/hospitality_excellence_system/DESIGN.md", "source_location": "Typography", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Inter chosen for exceptional mobile legibility and neutral systematic character; hierarchy leads with room number/primary task; Uzbek labels ensure immediate recognizability for staff."}, {"id": "desiginexample_hospitality_excellence_system_design_mobile_first_fluid_grid", "label": "Mobile-First Fluid Grid Layout", "file_type": "concept", "source_file": "DesiginExample/hospitality_excellence_system/DESIGN.md", "source_location": "Layout & Spacing", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Designed for one-handed operation; 20px margins prevent accidental edge touches; 8px vertical rhythm; 48px minimum touch targets accommodate staff wearing gloves or moving quickly between rooms."}, {"id": "desiginexample_hospitality_excellence_system_design_soft_ambient_shadows", "label": "Soft Ambient Shadows Elevation", "file_type": "concept", "source_file": "DesiginExample/hospitality_excellence_system/DESIGN.md", "source_location": "Elevation & Depth", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Depth via subtle shadows instead of heavy borders separates white cards from white background; active In Progress cards elevate to Level 2 to draw focus; modal blurs used sparingly to keep the user grounded in the room dashboard context."}, {"id": "desiginexample_hospitality_excellence_system_design_rounded_shapes", "label": "Rounded Shape Language (16-20px radius)", "file_type": "concept", "source_file": "DesiginExample/hospitality_excellence_system/DESIGN.md", "source_location": "Shapes", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "High corner radius softens the industrial feel of hospitality software; pill-shaped badges are visually distinguished from structural cards."}, {"id": "desiginexample_hospitality_excellence_system_design_room_cards", "label": "Room Cards (Xona Kartochkalari)", "file_type": "concept", "source_file": "DesiginExample/hospitality_excellence_system/DESIGN.md", "source_location": "Components > Cards", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "desiginexample_hospitality_excellence_system_design_buttons", "label": "Buttons (Tugmalar)", "file_type": "concept", "source_file": "DesiginExample/hospitality_excellence_system/DESIGN.md", "source_location": "Components > Buttons", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "desiginexample_hospitality_excellence_system_design_status_badges", "label": "Status Badges", "file_type": "concept", "source_file": "DesiginExample/hospitality_excellence_system/DESIGN.md", "source_location": "Components > Status Badges", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "desiginexample_hospitality_excellence_system_design_progress_indicators", "label": "Progress Indicators", "file_type": "concept", "source_file": "DesiginExample/hospitality_excellence_system/DESIGN.md", "source_location": "Components > Progress Indicators", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "desiginexample_hospitality_excellence_system_design_checklist_items", "label": "Checklist Items Component", "file_type": "concept", "source_file": "DesiginExample/hospitality_excellence_system/DESIGN.md", "source_location": "Components > Checklist Items", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Large 24px checkbox and whole-row tap target chosen to facilitate rapid movement through room cleaning ste